10 REM ================================================================
20 REM TIC-TAC-TOE - THE HUMAN (X) VS THE COMPUTER (O) - TTY STYLE.
30 REM THE BOARD CELLS ARE NUMBERED 1-9, TOP ROW TO BOTTOM ROW
31 REM (1 2 3 OVER 4 5 6 OVER 7 8 9, ONE ROW AT A TIME).
90 REM A PLAYED CELL SHOWS X (THE HUMAN) OR O (THE COMPUTER).
100 REM ENTER A MOVE AS THE NUMBER 1-9 OF A FREE CELL.
110 REM EASY: THE COMPUTER MOVES AT RANDOM.
120 REM MEDIUM: THE COMPUTER TAKES A WIN AND BLOCKS A LOSS.
130 REM ================================================================
140 DIM B(9), L1(8), L2(8), L3(8), D$(9)
150 RANDOMIZE VAL(MID$(TIME$, 4, 2)) * 100 + VAL(MID$(TIME$, 7, 2))
160 CLS
170 PRINT
180 PRINT "        TIC-TAC-TOE"
190 PRINT "        --------------"
200 PRINT
210 PRINT "    YOU ARE X, THE COMPUTER IS O."
220 PRINT "    THE CELLS ARE NUMBERED:"
230 PRINT "     1 | 2 | 3"
240 PRINT "    ---+---+---"
250 PRINT "     4 | 5 | 6"
260 PRINT "    ---+---+---"
270 PRINT "     7 | 8 | 9"
280 PRINT
290 FOR I = 1 TO 9
300 D$(I) = MID$(STR$(I), 2)
310 NEXT I
320 L1(1) = 1 : L2(1) = 2 : L3(1) = 3
330 L1(2) = 4 : L2(2) = 5 : L3(2) = 6
340 L1(3) = 7 : L2(3) = 8 : L3(3) = 9
350 L1(4) = 1 : L2(4) = 4 : L3(4) = 7
360 L1(5) = 2 : L2(5) = 5 : L3(5) = 8
370 L1(6) = 3 : L2(6) = 6 : L3(6) = 9
380 L1(7) = 1 : L2(7) = 5 : L3(7) = 9
390 L1(8) = 3 : L2(8) = 5 : L3(8) = 7
400 REM ---- the difficulty menu ---------------------------------------
410 PRINT "    1 - EASY (THE COMPUTER MOVES AT RANDOM)"
420 PRINT "    2 - MEDIUM (TAKES A WIN AND BLOCKS A LOSS)"
430 INPUT "    DIFFICULTY (1 OR 2): ", K$
440 H = VAL(K$)
450 IF H = 1 OR H = 2 THEN GOTO 700
460 PRINT "    ENTER 1 OR 2."
470 GOTO 430
700 REM ---- a new game (H = 1 EASY, 2 MEDIUM, KEPT FOR REPLAYS) ------
710 CLS
720 FOR I = 1 TO 9
730 B(I) = 0
740 NEXT I
750 GOTO 1000
1000 REM ---- the human turn (X) -----------------------------------------
1010 GOSUB 1900
1015 PRINT
1020 INPUT "    YOUR MOVE (1-9): ", M$
1030 M = VAL(M$)
1040 IF M < 1 OR M > 9 THEN GOTO 1060
1050 IF B(M) <> 0 THEN GOTO 1060
1055 GOTO 1080
1060 PRINT "    ENTER A FREE CELL BETWEEN 1 AND 9."
1070 GOTO 1020
1080 B(M) = 1
1090 GOSUB 1550
1100 IF W = 1 THEN GOTO 1400
1110 FOR I = 1 TO 9
1120 IF B(I) = 0 THEN GOTO 1200
1130 NEXT I
1140 GOTO 1480
1200 REM ---- the computer turn (O) --------------------------------------
1210 GOSUB 1700
1220 B(I) = 2
1230 GOSUB 1550
1240 IF W = 2 THEN GOTO 1450
1250 GOTO 1000
1400 REM ---- the endings -------------------------------------------------
1410 GOSUB 1900
1420 PRINT
1430 PRINT "    YOU WIN!"
1440 GOTO 1490
1450 GOSUB 1900
1460 PRINT
1470 PRINT "    THE COMPUTER WINS."
1475 GOTO 1490
1480 GOSUB 1900
1481 PRINT
1482 PRINT "    A DRAW."
1490 INPUT "    PLAY AGAIN (Y/N)? ", R$
1500 IF R$ = "Y" OR R$ = "y" THEN GOTO 700
1510 PRINT "    THANKS FOR PLAYING."
1520 END
1550 REM GOSUB 1550: THE WINNER CHECK.
1560 REM W = 0 NO WINNER, 1 THE HUMAN, 2 THE COMPUTER.
1570 W = 0
1580 FOR L = 1 TO 8
1590 IF W = 0 AND B(L1(L)) <> 0 AND B(L1(L)) = B(L2(L)) AND B(L2(L)) = B(L3(L)) THEN W = B(L1(L))
1600 NEXT L
1610 RETURN
1700 REM GOSUB 1700: THE COMPUTER MOVE (H = 1 EASY, 2 MEDIUM).
1710 REM ON RETURN, I IS THE CHOSEN CELL (B UNCHANGED).
1720 IF H = 1 THEN GOTO 1790
1730 REM (A) TAKE A WIN.
1740 FOR I = 1 TO 9
1741 IF B(I) <> 0 THEN GOTO 1750
1742 B(I) = 2
1743 GOSUB 1550
1744 IF W = 2 THEN RETURN
1745 B(I) = 0
1750 NEXT I
1751 REM (B) BLOCK A LOSS.
1760 FOR I = 1 TO 9
1761 IF B(I) <> 0 THEN GOTO 1770
1762 B(I) = 1
1763 GOSUB 1550
1764 IF W = 1 THEN GOTO 1780
1765 B(I) = 0
1770 NEXT I
1775 GOTO 1790
1780 RETURN
1790 REM (C) A RANDOM FREE CELL (THE EASY MOVE AND MEDIUM FALLBACK).
1791 REM THE RND CLAMP: THE ENGINE'S RND CAN REACH 1 (A SEED'S LCG STATE),
1792 REM AND THE FORMULA WOULD THEN YIELD A 10 OUTSIDE THE BOARD.
1793 FOR T = 1 TO 20
1794 M = INT(RND(1) * 8.98 + 1.01)
1795 IF M < 1 THEN M = 1
1796 IF M > 9 THEN M = 9
1797 IF B(M) <> 0 THEN GOTO 1803
1798 I = M : GOTO 1810
1803 NEXT T
1804 FOR I = 1 TO 9
1805 IF B(I) = 0 THEN GOTO 1810
1806 NEXT I
1810 REM I IS THE CHOSEN CELL (THE RANDOM HIT, OR THE FIRST FREE CELL).
1820 RETURN
1900 REM GOSUB 1900: THE BOARD DISPLAY (1-3 TOP ROW, 7-9 BOTTOM).
1910 PRINT
1920 FOR R = 1 TO 3
1930 I = 3 * R - 2
1940 GOSUB 1970
1941 A$ = C$
1942 I = I + 1
1943 GOSUB 1970
1944 B$ = C$
1945 I = I + 1
1946 GOSUB 1970
1950 REM THE ROW CELLS ARE NOW IN A$, B$ AND C$.
1960 PRINT "    "; A$; "|"; B$; "|"; C$
1961 IF R = 3 THEN RETURN
1962 PRINT "    ---+---+---"
1963 NEXT R
1970 REM THE CELL CHARACTER (THE CELL NUMBER IN I) INTO C$.
1980 IF B(I) = 0 THEN GOTO 1990
1981 IF B(I) = 1 THEN GOTO 1991
1982 C$ = " O " : RETURN
1990 C$ = " " + D$(I) + " " : RETURN
1991 C$ = " X " : RETURN
