10 REM SNAKE - A SCREEN 720 GAME
20 REM CONTROLS: WASD OR ARROW KEYS, H = HELP, Q = QUIT, R = RETRY
30 SCREEN 720
40 DIM SX(2000), SY(2000)
50 COLS=60: ROWS=31: CELL=20: X0=40: Y0=64
60 PALETTE 0, 0
70 PALETTE 1, 0+50*256+0
80 PALETTE 2, 63+0*256+0
90 PALETTE 3, 63+55*256+0
100 PALETTE 4, 0+30*256+63*65536
110 PALETTE 5, 63+63*256+63*65536
120 PALETTE 6, 0+14*256+8*65536
130 PALETTE 7, 63+63*256+63*65536
140 GOSUB 1000
150 GOTO 200

1000 REM ---- START A NEW GAME ----
1010 SL=5: HEADX=30: HEADY=15: DIRX=1: DIRY=0: SCORE=0: SPEED=.12
1020 FOR I=1 TO SL: SX(I)=HEADX-I+1: SY(I)=HEADY: NEXT I
1030 GOSUB 7000
1040 TLAST=TIMER
1050 GOSUB 5000
1060 RETURN

200 REM ---- INPUT AND TIMING ----
210 K$=INKEY$
220 IF K$="" THEN 300
225 C=ASC(K$)
230 IF C=72 OR C=104 THEN GOSUB 9000: GOTO 200
240 IF C=81 OR C=113 THEN END
250 IF (C=87 OR C=119 OR C=130) AND DIRY=0 THEN DIRX=0: DIRY=-1
260 IF (C=83 OR C=115 OR C=136) AND DIRY=0 THEN DIRX=0: DIRY=1
270 IF (C=65 OR C=97 OR C=137) AND DIRX=0 THEN DIRX=-1: DIRY=0
280 IF (C=68 OR C=100 OR C=140) AND DIRX=0 THEN DIRX=1: DIRY=0
300 IF TIMER-TLAST < SPEED THEN 200
310 TLAST=TIMER

320 REM ---- MOVE ONE CELL ----
330 NX=HEADX+DIRX: NY=HEADY+DIRY
340 EAT=0: IF NX=FX AND NY=FY THEN EAT=1
350 IF NX<0 OR NX>=COLS OR NY<0 OR NY>=ROWS THEN 800
360 CHECKLEN=SL: IF EAT=0 THEN CHECKLEN=SL-1
370 IF CHECKLEN<1 THEN 400
380 FOR I=1 TO CHECKLEN
390 IF SX(I)=NX AND SY(I)=NY THEN 800
400 NEXT I
410 IF EAT=1 THEN SL=SL+1: SCORE=SCORE+1: IF SPEED>.07 THEN SPEED=SPEED-.002: BEEP
420 FOR I=SL TO 2 STEP -1: SX(I)=SX(I-1): SY(I)=SY(I-1): NEXT I
430 SX(1)=NX: SY(1)=NY: HEADX=NX: HEADY=NY
440 IF EAT=1 THEN GOSUB 7000
450 GOSUB 5000
460 GOTO 200

800 REM ---- GAME OVER ----
810 BEEP
820 GOSUB 5000
830 LOCATE 15,30: PRINT "GAME OVER"
850 LOCATE 17,28: PRINT "SCORE "; SCORE
860 LOCATE 19,22: PRINT "R = RETRY   H = HELP   Q = QUIT"
870 K$=INKEY$: IF K$="" THEN 870
880 C=ASC(K$)
890 IF C=81 OR C=113 THEN END
900 IF C=72 OR C=104 THEN GOSUB 9000: GOTO 800
910 IF C=82 OR C=114 THEN GOSUB 1000: GOTO 200
920 GOTO 870

5000 REM ---- DRAW BOARD, SNAKE AND FOOD ----
5010 CLS
5015 LINE (0,0)-(1279,719),0,BF
5020 LOCATE 1,1: PRINT "SNAKE"
5040 LOCATE 1,70: PRINT "SCORE "; SCORE
5050 LOCATE 2,1: PRINT "WASD / ARROWS   H = HELP   Q = QUIT"
5060 LINE (X0-3,Y0-3)-(X0+COLS*CELL+3,Y0+ROWS*CELL+3),4,B
5070 LINE (X0-1,Y0-1)-(X0+COLS*CELL+1,Y0+ROWS*CELL+1),7,B
5080 FOR GX=1 TO COLS-1: LINE (X0+GX*CELL,Y0)-(X0+GX*CELL,Y0+ROWS*CELL),6: NEXT GX
5090 FOR GY=1 TO ROWS-1: LINE (X0,Y0+GY*CELL)-(X0+COLS*CELL,Y0+GY*CELL),6: NEXT GY
5100 FOR I=SL TO 1 STEP -1
5110 C=1: IF I=1 THEN C=3
5120 XX=X0+SX(I)*CELL: YY=Y0+SY(I)*CELL
5130 LINE (XX+1,YY+1)-(XX+CELL-2,YY+CELL-2),C,BF
5140 NEXT I
5150 XX=X0+FX*CELL: YY=Y0+FY*CELL
5160 LINE (XX+3,YY+3)-(XX+CELL-4,YY+CELL-4),2,BF
5170 RETURN

7000 REM ---- PLACE FOOD ON A FREE CELL ----
7010 FX=INT(RND*COLS): FY=INT(RND*ROWS)
7020 FOR I=1 TO SL
7030 IF SX(I)=FX AND SY(I)=FY THEN 7010
7040 NEXT I
7050 RETURN

9000 REM ---- HELP SCREEN ----
9010 CLS
9020 LOCATE 3,18: PRINT "SNAKE - HELP"
9040 LOCATE 6,10: PRINT "MOVE:  W / A / S / D   OR THE ARROW KEYS"
9050 LOCATE 8,10: PRINT "EAT THE RED FOOD TO GROW AND SCORE POINTS."
9060 LOCATE 10,10: PRINT "HIT A WALL OR YOURSELF AND THE GAME ENDS."
9070 LOCATE 12,10: PRINT "H = THIS HELP SCREEN"
9080 LOCATE 14,10: PRINT "Q = QUIT"
9090 LOCATE 16,10: PRINT "R = RETRY AFTER GAME OVER"
9100 LOCATE 20,10: PRINT "PRESS ANY KEY TO RETURN TO THE GAME"
9110 K$=INKEY$: IF K$="" THEN 9110
9120 IF K$="Q" OR K$="q" THEN END
9130 GOSUB 5000
9140 TLAST=TIMER
9150 RETURN
