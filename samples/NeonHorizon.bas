10 REM NEON HORIZON - a SCREEN 720 (1280x720, 256-colour) graphics demo.
11 REM
12 REM A synthwave sunset: gradient sky, striped sun, layered ridges, stars and a
13 REM perspective grid scrolling toward the viewer. The background is painted once
14 REM and animated by rewriting its palette entries, so each frame only clears and
15 REM redraws the floor, the reflection and the star twinkle.
16 REM
17 REM Controls: ESC quits, SPACE pauses, +/- changes grid speed, C (or a click)
18 REM cycles the sunset / aurora / ice themes.
19 REM
20 SCREEN 720
30 CLS
40 HZ = 500: VP = 640: SR = 130: SC = 390
50 PH = 0: SP = .6: PS = 0: TH = 0
55 DIM SX(180), SY(180), CL(180)
60 GOSUB 1000
70 GOSUB 2000
80 GOSUB 3000
90 GOSUB 4000
100 GOSUB 5000
110 GOSUB 6000
120 GOSUB 6200
130 GOSUB 7000
140 TL = TIMER
150 REM ---- MAIN LOOP ----
160 TF = TIMER
170 GOSUB 6000
180 GOSUB 6200
190 GOSUB 6300
200 B = MOUSEB
210 IF B <> 0 THEN GOSUB 8100
220 K$ = INKEY$
230 IF K$ <> "" THEN GOSUB 8000
240 IF PS = 1 THEN 280
250 T = TIMER: DT = T - TL
260 PH = PH + DT * SP
270 IF PH >= 1 THEN PH = PH - 1
280 IF TIMER - TF < .033 THEN 280
290 TL = TIMER
300 GOTO 160
310 END

1000 REM ---- PALETTE: SKY 64-127, SUN 128-159, GRID 224-227 ----
1010 FOR I = 0 TO 63
1020 T = I / 63
1030 IF TH = 0 THEN GOSUB 1300
1040 IF TH = 1 THEN GOSUB 1320
1050 IF TH = 2 THEN GOSUB 1340
1060 GOSUB 9000
1070 PALETTE 64 + I, PC
1080 NEXT I
1090 FOR I = 0 TO 31
1100 T = I / 31
1110 IF TH = 0 THEN PR = 255: PG = 235 - 195 * T: PB = 90 + 80 * T
1120 IF TH = 1 THEN PR = 200 - 180 * T: PG = 255 - 75 * T: PB = 170 - 50 * T
1130 IF TH = 2 THEN PR = 220 - 140 * T: PG = 245 - 105 * T: PB = 255
1140 GOSUB 9000
1150 PALETTE 128 + I, PC
1160 NEXT I
1170 IF TH = 0 THEN PR = 255: PG = 50: PB = 170
1180 IF TH = 1 THEN PR = 40: PG = 255: PB = 170
1190 IF TH = 2 THEN PR = 180: PG = 220: PB = 255
1200 GOSUB 9000: PALETTE 224, PC
1210 PR = PR * .82: PG = PG * .82: PB = PB * .82: GOSUB 9000: PALETTE 225, PC
1220 PR = 255: PG = 235: PB = 255: GOSUB 9000: PALETTE 226, PC
1230 IF TH = 0 THEN PR = 110: PG = 18: PB = 88
1240 IF TH = 1 THEN PR = 12: PG = 80: PB = 62
1250 IF TH = 2 THEN PR = 30: PG = 50: PB = 90
1260 GOSUB 9000: PALETTE 227, PC
1270 PR = 46: PG = 18: PB = 64: GOSUB 9000: PALETTE 176, PC
1280 PR = 28: PG = 10: PB = 42: GOSUB 9000: PALETTE 177, PC
1285 PR = 10: PG = 3: PB = 20: GOSUB 9000: PALETTE 178, PC
1287 PR = 6: PG = 2: PB = 14: GOSUB 9000: PALETTE 16, PC
1289 PR = 120: PG = 140: PB = 200: GOSUB 9000: PALETTE 200, PC
1290 PR = 255: PG = 255: PB = 255: GOSUB 9000: PALETTE 201, PC
1291 PR = 170: PG = 210: PB = 255: GOSUB 9000: PALETTE 202, PC
1292 PR = 255: PG = 180: PB = 230: GOSUB 9000: PALETTE 203, PC
1293 IF TH = 0 THEN PR = 255: PG = 120: PB = 210
1294 IF TH = 1 THEN PR = 100: PG = 255: PB = 190
1295 IF TH = 2 THEN PR = 190: PG = 225: PB = 255
1296 GOSUB 9000: PALETTE 208, PC
1297 PR = 90: PG = 255: PB = 240: GOSUB 9000: PALETTE 240, PC
1298 PR = 235: PG = 235: PB = 255: GOSUB 9000: PALETTE 241, PC
1299 RETURN

1300 REM ---- SKY THEME 0: sunset ----
1310 IF T < .55 THEN U = T / .55: PR = 8 + 72 * U: PG = 4 + 16 * U: PB = 30 + 80 * U: RETURN
1315 U = (T - .55) / .45: PR = 80 + 175 * U: PG = 20 + 30 * U: PB = 110 + 10 * U
1318 RETURN
1320 REM ---- SKY THEME 1: aurora ----
1325 IF T < .55 THEN U = T / .55: PR = 4 + 6 * U: PG = 10 + 70 * U: PB = 26 + 44 * U: RETURN
1330 U = (T - .55) / .45: PR = 10 + 30 * U: PG = 80 + 175 * U: PB = 70 + 100 * U
1335 RETURN
1340 REM ---- SKY THEME 2: ice ----
1345 IF T < .55 THEN U = T / .55: PR = 4 + 26 * U: PG = 8 + 42 * U: PB = 24 + 96 * U: RETURN
1350 U = (T - .55) / .45: PR = 30 + 150 * U: PG = 50 + 180 * U: PB = 120 + 135 * U
1355 RETURN

2000 REM ---- SKY: 4-pixel bands, palette 64 at the top to 127 at the horizon ----
2010 FOR Y = 0 TO 496 STEP 4
2020 C = 64 + INT(Y * 63 / 496)
2030 LINE (0, Y)-(1279, Y + 3), C, BF
2040 NEXT Y
2050 RETURN

3000 REM ---- STARS: deterministic scatter above the ridges ----
3010 FOR I = 1 TO 170
3020 F = SIN(I * 12.9898) * 43758.5453: R = F - INT(F)
3030 SX(I) = INT(R * 1279)
3040 F = SIN(I * 78.233 + 1.7) * 24634.6345: R = F - INT(F)
3050 SY(I) = INT(R * 430)
3060 CL(I) = 200 + (I MOD 4)
3070 PSET (SX(I), SY(I)), CL(I)
3080 NEXT I
3090 RETURN

4000 REM ---- SUN: vertical gradient, with gaps in the lower half ----
4010 FOR Y = SC - SR TO SC + SR STEP 2
4020 DY = (Y - SC) / SR
4030 IF ABS(DY) > 1 THEN 4090
4040 HW = INT(SR * SQR(1 - DY * DY))
4050 C = 128 + INT((Y - (SC - SR)) * 31 / (2 * SR))
4060 IF Y > SC AND ((Y - SC) MOD 12) < 4 THEN 4090
4070 LINE (VP - HW, Y)-(VP + HW, Y + 1), C, BF
4090 NEXT Y
4100 RETURN

5000 REM ---- MOUNTAINS: two ridges, filled a column at a time ----
5010 FOR X = 0 TO 1276 STEP 4
5020 T1 = 440 + 24 * SIN(X * .006 + .8) + 14 * SIN(X * .023 + 2) + 7 * SIN(X * .051)
5030 T2 = 472 + 20 * SIN(X * .004 + 3.1) + 15 * SIN(X * .017 + .3) + 6 * SIN(X * .061 + 1)
5040 LINE (X, T1)-(X + 3, 499), 177, BF
5050 LINE (X, T2)-(X + 3, 499), 178, BF
5060 IF T1 < 410 THEN LINE (X, T1)-(X + 3, T1 + 6), 176, BF
5070 NEXT X
5080 RETURN

6000 REM ---- GROUND AND SCROLLING PERSPECTIVE GRID ----
6010 LINE (0, HZ)-(1279, 719), 16, BF
6020 FOR K = 1 TO 40
6030 Z = K - PH
6040 Y = -1
6050 IF Z > .05 THEN Y = HZ + INT(220 * Z / (Z + 5))
6060 IF Y < 0 THEN 6090
6070 C = 225
6080 IF K MOD 4 = 0 THEN C = 226
6085 LINE (0, Y)-(1279, Y), C
6090 NEXT K
6100 O = (PH - .5) * 95
6110 FOR N = -14 TO 14
6120 XB = VP + N * 95 + O
6130 C = 225
6140 IF N MOD 2 = 0 THEN C = 224
6150 LINE (VP, HZ)-(XB, 760), C
6160 NEXT N
6165 LINE (0, 688)-(1279, 719), 16, BF
6170 RETURN

6200 REM ---- SUN REFLECTION: dashed bands under the horizon ----
6210 FOR Y = 512 TO 704 STEP 24
6220 W = INT((Y - HZ) * .6)
6230 IF W > 155 THEN W = 155
6240 FOR X = 0 TO 2 * W STEP 25
6250 XP = VP - W + X
6260 IF ((X + INT(PH * 25)) MOD 50) < 25 THEN LINE (XP, Y)-(XP + 13, Y), 208
6270 NEXT X
6280 NEXT Y
6290 RETURN

6300 REM ---- STAR TWINKLE: palette entries 200-203 ----
6310 T = TIMER
6320 FOR I = 0 TO 3
6330 V = .55 + .45 * SIN(T * 1.6 + I * 1.7)
6340 V = .45 + .55 * V
6350 IF I = 0 THEN PR = 120: PG = 140: PB = 200
6360 IF I = 1 THEN PR = 255: PG = 255: PB = 255
6370 IF I = 2 THEN PR = 170: PG = 210: PB = 255
6380 IF I = 3 THEN PR = 255: PG = 180: PB = 230
6390 PR = PR * V: PG = PG * V: PB = PB * V
6400 GOSUB 9000
6410 PALETTE 200 + I, PC
6420 NEXT I
6430 RETURN

7000 REM ---- HUD ----
7010 LOCATE 2, 60
7020 COLOR 240
7030 PRINT "N E O N   H O R I Z O N";
7040 LOCATE 44, 2
7050 COLOR 241
7060 PRINT "ESC QUIT   SPACE PAUSE   C THEME   +/- SPEED";
7065 LOCATE 45, 1, 0
7070 RETURN

8000 REM ---- INPUT ----
8010 C = ASC(K$)
8020 IF C = 27 THEN END
8025 IF K$ = "q" THEN END
8030 IF K$ = " " THEN PS = 1 - PS: RETURN
8040 IF K$ = "+" OR K$ = "=" THEN SP = SP * 1.25: IF SP > 4 THEN SP = 4
8050 IF K$ = "-" OR K$ = "_" THEN SP = SP / 1.25: IF SP < .15 THEN SP = .15
8060 IF K$ = "c" OR K$ = "C" THEN GOSUB 8100
8070 RETURN

8100 REM ---- NEXT THEME ----
8110 TH = TH + 1
8120 IF TH > 2 THEN TH = 0
8130 GOSUB 1000
8140 RETURN

9000 REM ---- 8-bit RGB in PR,PG,PB -> 18-bit PALETTE colour in PC ----
9010 PC = INT(PR * 63 / 255 + .5) + INT(PG * 63 / 255 + .5) * 256 + INT(PB * 63 / 255 + .5) * 65536
9020 RETURN
