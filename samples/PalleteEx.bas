10 REM NEWBASIC PALETTE LAB
20 REM SCREEN 720 demo for PALETTE and PALETTE USING.
30 REM P cycles the palette; Q or Escape quits.
40 SCREEN 720
50 DIM P%(255), C#(255), T$(3)
60 T$(0)="AURORA": T$(1)="SUNSET": T$(2)="OCEAN": T$(3)="NEON"
70 THEME=0
80 GOSUB 2000: REM build and install the palette
90 GOSUB 3000: REM draw the scene
100 GOSUB 4000: REM title and key labels
110 K$=INKEY$
120 IF K$="P" OR K$="p" THEN THEME=(THEME+1) MOD 4: GOSUB 2000: GOSUB 4000: GOTO 110
130 IF K$="Q" OR K$="q" OR K$=CHR$(27) THEN END
140 FOR D=1 TO 300: NEXT D
150 GOTO 110

2000 REM Build a 256-entry palette. The low entries fit in an
2010 REM integer array; the high 18-bit entries are installed with PALETTE.
2020 FOR I=0 TO 255
2030 R=0: G=0: B=0
2040 IF THEME=0 THEN R=(I*2+18) MOD 64: G=(I*3+28) MOD 64: B=(I+38) MOD 64
2050 IF THEME=1 THEN R=24+(I MOD 40): G=(I*2+8) MOD 48: B=(I/3) MOD 32
2060 IF THEME=2 THEN R=(I/4) MOD 24: G=20+(I*2) MOD 44: B=38+(I/2) MOD 26
2070 IF THEME=3 THEN R=(I*5) MOD 64: G=(I*3+28) MOD 64: B=(I*7+8) MOD 64
2080 C#(I)=R+G*256+B*65536
2090 IF C#(I)<=32767 THEN P%(I)=CINT(C#(I)) ELSE P%(I)=-1
2100 NEXT I
2110 PALETTE USING P%(0)
2120 FOR I=0 TO 255
2130 IF P%(I)=-1 THEN PALETTE I, C#(I)
2140 NEXT I
2150 PALETTE 255, 63+63*256+63*65536
2160 PALETTE 254, 0+63*256+63*65536
2170 RETURN

3000 REM Draw a scene once. Changing the palette recolours it all.
3010 CLS
3020 REM Background: 64 horizontal bands.
3030 FOR Y=0 TO 719 STEP 16
3040 BAND=INT(Y/720*64)
3050 LINE (0,Y)-(1279,Y+15), BAND, BF
3060 NEXT Y
3070 REM A large sun with concentric colour rings.
3080 FOR R=190 TO 1 STEP -6
3090 C=64+(190-R)/6 MOD 32
3100 CIRCLE (900,270), R, C
3110 NEXT R
3120 PAINT (900,270), 80, 95
3130 REM Horizon and layered hills.
3140 LINE (0,500)-(1279,500), 96, BF
3150 FOR X=0 TO 1279 STEP 8
3160 H=40+32*SIN(X/90)+18*SIN(X/31)
3170 C=96+(X/8 MOD 24)
3180 LINE (X,600-H)-(X+8,600), C, BF
3190 NEXT X
3200 REM Water bands.
3210 FOR W=0 TO 5
3220 C=120+W*4
3230 FOR X=0 TO 1279 STEP 4
3240 YY=610+W*8+8*SIN(X/60+W)
3250 PSET (X,YY), C
3260 NEXT X
3270 NEXT W
3280 REM Stars in the upper sky.
3290 FOR S=1 TO 140
3300 X=INT(RND*1280)
3310 Y=INT(RND*360)
3320 C=144+INT(RND*16)
3330 PSET (X,Y), C
3340 NEXT S
3350 REM Palette swatches: one 5-pixel bar per attribute.
3360 FOR I=0 TO 255
3370 X=I*5
3380 LINE (X,650)-(X+4,690), I, BF
3390 NEXT I
3400 RETURN

4000 REM Overlay title and key labels.
4010 COLOR 255, 0
4020 LOCATE 1,1
4030 PRINT "NEWBASIC PALETTE LAB - "; T$(THEME)
4040 PRINT "P = CHANGE PALETTE     Q/ESC = QUIT"
4050 LOCATE 3,1
4060 PRINT "SCREEN 720 - 256 COLOURS - PALETTE USING + PALETTE"
4070 LOCATE 41,1
4080 PRINT "SWATCHES 0";
4090 LOCATE 41,75
4100 PRINT "128";
4110 LOCATE 41,153
4120 PRINT "255";
4130 RETURN
