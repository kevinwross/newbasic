6985 KH(KI)=KH(KI)-HIT
6988 IF KH(KI)<=0 THEN KH(KI)=0:TOTAL=TOTAL-1:G(QX,QY)=G(QX,QY)-100:IF TARGET=KI THEN TARGET=0
6990 RETURN

6200 REM ---- FIRE TORPEDO ----
6210 IF TORPS<1 THEN MSG$="NO TORPEDOES LEFT":RETURN
6220 TORPS=TORPS-1
6230 TX=SX:TY=SY:HIT=0
6240 FOR ST=1 TO 8
6250 TX=TX+DX(HEADING):TY=TY+DY(HEADING)
6260 IF TX<1 OR TX>8 OR TY<1 OR TY>8 THEN ST=8:GOTO 6320
6270 QI=(QX-1)*8+QY
6280 FOR I=1 TO 3
6290 KI=(QI-1)*3+I
6300 IF KH(KI)>0 AND KX(KI)=TX AND KY(KI)=TY THEN KH(KI)=0:TOTAL=TOTAL-1:G(QX,QY)=G(QX,QY)-100:HIT=1:IF TARGET=KI THEN TARGET=0
6310 NEXT I
6315 IF HIT=1 THEN ST=8
6320 NEXT ST
6330 IF HIT=1 THEN MSG$="TORPEDO HIT" ELSE MSG$="TORPEDO MISSED"
6340 TLEFT=TLEFT-1:GOSUB 6500:GOSUB 6800:MODE$="COMMAND"
6350 RETURN

6400 REM ---- SHIELD TRANSFER ----
6405 IF SHDIR=1 THEN AMT=TRANS:IF AMT>ENERGY THEN AMT=ENERGY:ENERGY=ENERGY-AMT:SHIELDS=SHIELDS+AMT:MSG$="SHIELDS RAISED"
6410 IF SHDIR=-1 THEN AMT=TRANS:IF AMT>SHIELDS THEN AMT=SHIELDS:SHIELDS=SHIELDS-AMT:ENERGY=ENERGY+AMT:MSG$="SHIELDS LOWERED"
6415 TLEFT=TLEFT-1:GOSUB 6500:GOSUB 6800:MODE$="COMMAND"
6420 RETURN

6500 REM ---- KLINGON ATTACK ----
6510 QI=(QX-1)*8+QY:NK=0
6520 FOR I=1 TO 3:KI=(QI-1)*3+I:IF KH(KI)>0 THEN NK=NK+1
6530 NEXT I
6540 IF NK=0 THEN RETURN
6550 HIT=INT(NK*(20+RND*30))
6560 IF SHIELDS>=HIT THEN SHIELDS=SHIELDS-HIT:MSG$="SHIELDS ABSORBED THE HIT"
6570 IF SHIELDS<HIT THEN HULL=HULL-(HIT-SHIELDS):SHIELDS=0:MSG$="HULL BREACH"
6580 IF HULL<0 THEN HULL=0
6590 RETURN

6600 REM ---- (RESERVED) ----
6610 RETURN

6700 REM ---- STARBASE RESUPPLY ----
6710 IF BX(QX,QY)>0 AND BY(QX,QY)>0 AND BX(QX,QY)=SX AND BY(QX,QY)=SY THEN ENERGY=3000:TORPS=10:SHIELDS=0:HULL=100:MSG$="DOCKED - RESUPPLIED"
6720 RETURN

6800 REM ---- MISSION CHECK ----
6810 IF TOTAL<1 THEN OVER=1:WIN=1:MSG$="MISSION ACCOMPLISHED"
6820 IF TLEFT<1 THEN OVER=1:WIN=0:MSG$="TIME EXPIRED"
6830 IF HULL<1 THEN OVER=1:WIN=0:MSG$="ENTERPRISE DESTROYED"
6840 RETURN

7000 REM ---- VALUE BAR ----
7010 IF BVV<0 THEN BVV=0
7020 IF BVV>BMV THEN BVV=BMV
7030 LINE (BXV,BYV)-(BXV+BWV,BYV+BHV),4,B
7040 FW=INT((BWV-2)*BVV/BMV)
7050 IF FW>0 THEN LINE (BXV+1,BYV+1)-(BXV+FW,BYV+BHV-1),BCV,BF
7060 RETURN

7200 REM ---- BUTTON ----
7210 LINE (BTX,BTY)-(BTX+BTW,BTY+BTH),BTCOL,BF
7220 LINE (BTX,BTY)-(BTX+BTW,BTY+BTH),4,B
7230 LOCATE INT((BTY+4)/16)+1,INT(BTX/8)+2:PRINT BT$;
7240 RETURN

8000 REM ---- HELP OVERLAY ----
8010 CLS:LINE (260,150)-(1020,570),0,BF
8020 LINE (260,150)-(1020,570),4,B
8030 LOCATE 12,38:PRINT "STAR TREK NG - HELP"
8040 LOCATE 15,30:PRINT "MOUSE: CLICK A COMMAND BUTTON ALONG THE BOTTOM"
8050 LOCATE 17,30:PRINT "NAV: PICK A DIRECTION OR CLICK THE SCANNER, THEN ENGAGE"
8060 LOCATE 19,30:PRINT "PHASERS: SET POWER, THEN FIRE"
8070 LOCATE 21,30:PRINT "TORPEDO: LOCK A KLINGON ON THE SCANNER, THEN FIRE"
8080 LOCATE 23,30:PRINT "SHIELDS: SET TRANSFER, THEN APPLY"
8090 LOCATE 25,30:PRINT "KEYS: N S P T E D C ?   Q QUITS"
8100 LOCATE 29,36:PRINT "CLICK OR PRESS A KEY TO CLOSE"
8110 RETURN

8500 REM ---- GAME OVER OVERLAY ----
8510 CLS:LINE (320,210)-(960,520),0,BF
8520 LINE (320,210)-(960,520),2,B
8530 LOCATE 15,44:PRINT "MISSION ENDED"
8540 IF WIN=1 THEN LOCATE 18,38:PRINT "THE KLINGON FORCE HAS BEEN DEFEATED"
8550 IF WIN=0 THEN LOCATE 18,38:PRINT "THE ENTERPRISE HAS BEEN LOST"
8560 LOCATE 21,40:PRINT "STARDATE";STARDATE
8570 LOCATE 23,36:PRINT "ENERGY";INT(ENERGY);"  HULL";INT(HULL);"%"
8580 LOCATE 27,38:PRINT "R = RESTART    Q = QUIT"
8590 BTX=400:BTY=430:BTW=160:BTH=40:BT$="RESTART":BTCOL=1:GOSUB 7200
8595 BTX=700:BTY=430:BTW=160:BTH=40:BT$="QUIT":BTCOL=2:GOSUB 7200
8598 RETURN
