10 REM ================================================================
20 REM NEWBASIC ACCOUNTING - DOUBLE ENTRY BOOKKEEPING.
30 REM SCREENS: JOURNAL ENTRY, BILLING, PAYMENTS. FORMS USE LOCATE.
40 REM REPORTS USE PRINT USING. RUN FROM THE REPO ROOT.
45 REM DATE FIELDS OPEN ON TODAY: TYPE TO REPLACE IT, BACKSPACE TO EDIT.
47 REM DATES ARE MM/DD/YYYY AND MUST BE REAL DATES (1900-2099).
50 REM DATA: samples\accounting.dat, ONE "|"-SEPARATED RECORD PER ENTRY:
55 REM TYPE|REF|DATE|DESCRIPTION|DEBIT|CREDIT|AMOUNT  (1=J 2=BILL 3=PAY)
60 REM ================================================================
70 DIM AC(20), NM$(20), TY(20), BL(20)
80 DIM JR$(300), JT$(300), JX$(300), JD(300), JC(300), JM(300), JY(300), F$(10)
90 DF$ = "samples\accounting.dat"
92 TD$ = MID$(DATE$, 1, 2) + "/" + MID$(DATE$, 4, 2) + "/" + MID$(DATE$, 7, 4)
95 FB$ = "  \" + SPACE$(34) + "\  ####,###.##  ####,###.##"
96 FI$ = "  \" + SPACE$(34) + "\  ####,###.##"
97 FJ$ = "  !  \" + SPACE$(8) + "\  \" + SPACE$(8) + "\  \" + SPACE$(20) + "\  ####/####  ####,###.##"
98 FK$ = "  \" + SPACE$(8) + "\  \" + SPACE$(18) + "\  ####,###.##  ####,###.##  ####,###.##"
99 GOSUB 5000
100 GOSUB 5100
110 GOSUB 200
120 END
200 REM ---- MAIN MENU ------------------------------------------------
210 CLS
220 LOCATE 2,31: PRINT "NEWBASIC ACCOUNTING"
230 LOCATE 4,29: PRINT "1  JOURNAL ENTRY"
240 LOCATE 5,29: PRINT "2  BILL A CUSTOMER"
250 LOCATE 6,29: PRINT "3  ACCEPT A PAYMENT"
260 LOCATE 7,29: PRINT "4  JOURNAL"
270 LOCATE 8,29: PRINT "5  TRIAL BALANCE"
280 LOCATE 9,29: PRINT "6  INCOME STATEMENT"
290 LOCATE 10,29: PRINT "7  BALANCE SHEET"
300 LOCATE 11,29: PRINT "8  QUIT"
310 LOCATE 13,29: PRINT "CHOICE: ";
320 LOCATE 13,37: INPUT "", K$
330 IF K$ = "1" THEN GOSUB 1000 : GOTO 210
340 IF K$ = "2" THEN GOSUB 1500 : GOTO 210
350 IF K$ = "3" THEN GOSUB 2000 : GOTO 210
360 IF K$ = "4" THEN GOSUB 3750 : GOSUB 8000 : GOTO 210
370 IF K$ = "5" THEN GOSUB 2600 : GOSUB 8000 : GOTO 210
380 IF K$ = "6" THEN GOSUB 2900 : GOSUB 8000 : GOTO 210
390 IF K$ = "7" THEN GOSUB 3250 : GOSUB 8000 : GOTO 210
400 IF K$ = "8" THEN RETURN
410 GOTO 210
1000 REM ---- JOURNAL ENTRY (ANY TWO ACCOUNTS) -------------------------
1010 CLS
1020 LOCATE 2,31: PRINT "JOURNAL ENTRY"
1030 LOCATE 4,5: PRINT "REFERENCE  :"
1040 LOCATE 5,5: PRINT "DATE       :"
1050 LOCATE 6,5: PRINT "DESCRIPTION:"
1060 LOCATE 8,5: PRINT "DEBIT ACCT :"
1070 LOCATE 9,5: PRINT "CREDIT ACCT:"
1080 LOCATE 10,5: PRINT "AMOUNT     :"
1090 LOCATE 12,5: PRINT "ACCOUNT NUMBERS"
1100 LOCATE 13,5: PRINT "1000 CASH              1100 ACCOUNTS RECEIVABLE"
1110 LOCATE 14,5: PRINT "1200 SUPPLIES          1500 EQUIPMENT"
1120 LOCATE 15,5: PRINT "2000 ACCOUNTS PAYABLE  2100 SALES TAX PAYABLE"
1130 LOCATE 16,5: PRINT "3000 OWNERS EQUITY     3100 RETAINED EARNINGS"
1140 LOCATE 17,5: PRINT "4000 SERVICE REVENUE"
1150 LOCATE 18,5: PRINT "5000 RENT EXPENSE      5100 SALARIES EXPENSE"
1160 LOCATE 19,5: PRINT "5200 UTILITIES EXP     5300 SUPPLIES EXPENSE"
1170 LOCATE 21,5: PRINT "BLANK REFERENCE RETURNS TO THE MENU."
1200 GOSUB 7200 : LOCATE 4,22: PRINT SPACE$(45); : LOCATE 4,22: INPUT "", RF$
1210 IF RF$ = "" THEN RETURN
1220 IF INSTR(RF$, "|") > 0 THEN MSG$ = "NO | IN THE REFERENCE" : GOSUB 7000 : GOTO 1200
1225 GOSUB 7200 : DV$ = TD$
1230 R0 = 5 : C0 = 22 : GOSUB 7600 : DT$ = DV$
1240 GOSUB 7800 : IF OK = 1 THEN 1250
1242 IF VC = 1 THEN MSG$ = "USE MM/DD/YYYY (E.G. 10/20/2026)" ELSE MSG$ = "THAT DATE DOES NOT EXIST"
1244 GOSUB 7000 : DV$ = DT$ : GOTO 1230
1250 IF INSTR(DT$, "|") > 0 THEN MSG$ = "NO | IN THE DATE" : GOSUB 7000 : GOTO 1225
1260 GOSUB 7200 : LOCATE 6,22: PRINT SPACE$(45); : LOCATE 6,22: LINE INPUT "", DS$
1270 IF DS$ = "" THEN MSG$ = "A DESCRIPTION IS REQUIRED" : GOSUB 7000 : GOTO 1260
1280 IF INSTR(DS$, "|") > 0 THEN MSG$ = "NO | IN THE DESCRIPTION" : GOSUB 7000 : GOTO 1260
1290 GOSUB 7200 : LOCATE 8,22: PRINT SPACE$(45); : LOCATE 8,22: DA = 0 : INPUT "", DA
1300 AN = DA : GOSUB 4000
1310 IF AI = 0 THEN MSG$ = "ACCOUNT " + MID$(STR$(DA), 2) + " IS NOT IN THE CHART" : GOSUB 7000 : GOTO 1290
1320 DI = AI : LOCATE 8,34: PRINT SPACE$(38); : LOCATE 8,34: PRINT NM$(DI)
1330 GOSUB 7200 : LOCATE 9,22: PRINT SPACE$(45); : LOCATE 9,22: CA = 0 : INPUT "", CA
1340 IF CA = DA THEN MSG$ = "DEBIT AND CREDIT MUST BE DIFFERENT ACCOUNTS" : GOSUB 7000 : GOTO 1330
1350 AN = CA : GOSUB 4000
1360 IF AI = 0 THEN MSG$ = "ACCOUNT " + MID$(STR$(CA), 2) + " IS NOT IN THE CHART" : GOSUB 7000 : GOTO 1330
1370 CI = AI : LOCATE 9,34: PRINT SPACE$(38); : LOCATE 9,34: PRINT NM$(CI)
1380 GOSUB 7200 : LOCATE 10,22: PRINT SPACE$(45); : LOCATE 10,22: AM = 0 : INPUT "", AM
1390 IF AM <= 0 THEN MSG$ = "THE AMOUNT MUST BE POSITIVE" : GOSUB 7000 : GOTO 1380
1400 AM = INT(AM * 100 + 0.5) / 100
1410 LOCATE 10,22: PRINT SPACE$(45); : LOCATE 10,22: PRINT USING "####,###.##"; AM
1420 IF JE >= 300 THEN MSG$ = "THE JOURNAL IS FULL" : GOSUB 7000 : RETURN
1430 LOCATE 23,5: PRINT SPACE$(70);
1440 LOCATE 23,5: PRINT USING "DR #####   CR #####   AMOUNT ####,###.##"; DA; CA; AM
1450 LOCATE 24,5: PRINT SPACE$(70); : PRINT "PRESS ENTER TO POST, OR N TO CANCEL: ";
1460 INPUT "", Z$
1470 IF Z$ = "N" OR Z$ = "n" THEN RETURN
1480 JE = JE + 1
1485 JY(JE) = 1 : JR$(JE) = RF$ : JT$(JE) = DT$ : JX$(JE) = DS$ : JD(JE) = DA : JC(JE) = CA : JM(JE) = AM
1490 GOSUB 5300
1495 RETURN
1500 REM ---- BILL A CUSTOMER: DR A/R, CR THE INCOME ACCOUNT -------------
1510 CLS
1520 LOCATE 2,29: PRINT "BILL A CUSTOMER"
1530 LOCATE 4,5: PRINT "INVOICE #  :"
1540 LOCATE 5,5: PRINT "DATE       :"
1550 LOCATE 6,5: PRINT "CUSTOMER   :"
1560 LOCATE 8,5: PRINT "INCOME ACCT:"
1570 LOCATE 9,5: PRINT "AMOUNT     :"
1580 LOCATE 11,5: PRINT "INCOME ACCOUNTS (BLANK USES 4000)"
1590 LOCATE 12,5: PRINT "4000 SERVICE REVENUE"
1600 LOCATE 14,5: PRINT "POSTS DR 1100 A/R AND CR THE INCOME ACCOUNT."
1610 GOSUB 7200 : LOCATE 4,22: PRINT SPACE$(45); : LOCATE 4,22: INPUT "", RF$
1620 IF RF$ = "" THEN RETURN
1630 IF INSTR(RF$, "|") > 0 THEN MSG$ = "NO | IN THE INVOICE NUMBER" : GOSUB 7000 : GOTO 1610
1640 GOSUB 4100
1650 IF BI > 0 THEN MSG$ = "INVOICE " + RF$ + " HAS ALREADY BEEN BILLED" : GOSUB 7000 : GOTO 1610
1655 GOSUB 7200 : DV$ = TD$
1660 R0 = 5 : C0 = 22 : GOSUB 7600 : DT$ = DV$
1670 GOSUB 7800 : IF OK = 1 THEN 1680
1672 IF VC = 1 THEN MSG$ = "USE MM/DD/YYYY (E.G. 10/20/2026)" ELSE MSG$ = "THAT DATE DOES NOT EXIST"
1674 GOSUB 7000 : DV$ = DT$ : GOTO 1660
1680 IF INSTR(DT$, "|") > 0 THEN MSG$ = "NO | IN THE DATE" : GOSUB 7000 : GOTO 1655
1690 GOSUB 7200 : LOCATE 6,22: PRINT SPACE$(45); : LOCATE 6,22: LINE INPUT "", CU$
1700 IF CU$ = "" THEN MSG$ = "A CUSTOMER NAME IS REQUIRED" : GOSUB 7000 : GOTO 1690
1710 IF INSTR(CU$, "|") > 0 THEN MSG$ = "NO | IN THE CUSTOMER NAME" : GOSUB 7000 : GOTO 1690
1720 GOSUB 7200 : LOCATE 8,22: PRINT SPACE$(45); : LOCATE 8,22: IA = 4000 : INPUT "", IA
1730 AN = IA : GOSUB 4000
1740 IF AI = 0 THEN MSG$ = "ACCOUNT " + MID$(STR$(IA), 2) + " IS NOT IN THE CHART" : GOSUB 7000 : GOTO 1720
1750 IF TY(AI) <> 4 THEN MSG$ = "THAT ACCOUNT IS NOT AN INCOME ACCOUNT" : GOSUB 7000 : GOTO 1720
1760 LOCATE 8,34: PRINT SPACE$(38); : LOCATE 8,34: PRINT NM$(AI)
1770 GOSUB 7200 : LOCATE 9,22: PRINT SPACE$(45); : LOCATE 9,22: AM = 0 : INPUT "", AM
1780 IF AM <= 0 THEN MSG$ = "THE AMOUNT MUST BE POSITIVE" : GOSUB 7000 : GOTO 1770
1790 AM = INT(AM * 100 + 0.5) / 100
1800 LOCATE 9,22: PRINT SPACE$(45); : LOCATE 9,22: PRINT USING "####,###.##"; AM
1810 IF JE >= 300 THEN MSG$ = "THE JOURNAL IS FULL" : GOSUB 7000 : RETURN
1820 LOCATE 20,5: PRINT SPACE$(70);
1830 LOCATE 20,5: PRINT USING "DR 1100 A/R   CR #####   AMOUNT ####,###.##"; IA; AM
1840 LOCATE 22,5: PRINT SPACE$(70); : PRINT "PRESS ENTER TO POST, OR N TO CANCEL: ";
1850 INPUT "", Z$
1860 IF Z$ = "N" OR Z$ = "n" THEN RETURN
1870 JE = JE + 1
1880 JY(JE) = 2 : JR$(JE) = RF$ : JT$(JE) = DT$ : JX$(JE) = CU$ : JD(JE) = 1100 : JC(JE) = IA : JM(JE) = AM
1890 GOSUB 5300
1895 RETURN
2000 REM ---- ACCEPT A PAYMENT: DR CASH, CR A/R --------------------------
2010 CLS
2020 LOCATE 2,28: PRINT "ACCEPT A PAYMENT"
2030 LOCATE 3,5: PRINT "OPEN INVOICES"
2040 LOCATE 4,1: PRINT "  INVOICE"; TAB(15); "CUSTOMER"; TAB(42); "BILLED"; TAB(57); "PAID"; TAB(70); "OPEN"
2050 LOCATE 5,1: PRINT "  " + STRING$(10, "-") + "  " + STRING$(20, "-") + "  " + STRING$(11, "-") + "  " + STRING$(11, "-") + "  " + STRING$(11, "-")
2060 ROW = 6
2070 FOR J = 1 TO JE
2080 IF JY(J) <> 2 THEN 2140
2090 RF$ = JR$(J) : GOSUB 4200
2100 OP = JM(J) - PD
2110 IF OP <= 0.005 THEN 2140
2120 IF ROW > 13 THEN 2135
2125 LOCATE ROW,1: PRINT USING FK$; JR$(J); JX$(J); JM(J); PD; OP : ROW = ROW + 1
2130 GOTO 2140
2135 LOCATE 14,1: PRINT "  ... MORE OPEN INVOICES"
2140 NEXT J
2150 IF ROW > 6 THEN 2180
2160 LOCATE 16,5: PRINT "(NO OPEN INVOICES)"
2170 INPUT "", Z$
2175 RETURN
2180 LOCATE 16,5: PRINT "INVOICE #  :";
2190 LOCATE 16,18: PRINT SPACE$(20); : LOCATE 16,18: INPUT "", RF$
2200 IF RF$ = "" THEN RETURN
2210 GOSUB 4100
2220 IF BI = 0 THEN MSG$ = "INVOICE " + RF$ + " IS NOT IN THE LEDGER" : GOSUB 7000 : GOTO 2190
2230 GOSUB 4200
2240 OP = JM(BI) - PD
2250 IF OP <= 0.005 THEN MSG$ = "INVOICE " + RF$ + " IS ALREADY PAID" : GOSUB 7000 : GOTO 2190
2260 GOSUB 7200 : LOCATE 18,5: PRINT USING "OPEN ####,###.##   AMOUNT: "; OP;
2270 LOCATE 18,33: PRINT SPACE$(20); : LOCATE 18,33: AM = OP : INPUT "", AM
2280 IF AM <= 0 THEN MSG$ = "THE AMOUNT MUST BE POSITIVE" : GOSUB 7000 : GOTO 2270
2290 IF AM > OP + 0.005 THEN MSG$ = "THE PAYMENT EXCEEDS THE OPEN BALANCE" : GOSUB 7000 : GOTO 2270
2300 AM = INT(AM * 100 + 0.5) / 100
2310 LOCATE 18,33: PRINT SPACE$(20); : LOCATE 18,33: PRINT USING "####,###.##"; AM
2320 GOSUB 7200 : LOCATE 19,5: PRINT "DATE       :"; : DV$ = TD$
2330 R0 = 19 : C0 = 18 : GOSUB 7600 : DT$ = DV$
2340 GOSUB 7800 : IF OK = 1 THEN 2350
2342 IF VC = 1 THEN MSG$ = "USE MM/DD/YYYY (E.G. 10/20/2026)" ELSE MSG$ = "THAT DATE DOES NOT EXIST"
2344 GOSUB 7000 : DV$ = DT$ : GOTO 2330
2350 IF INSTR(DT$, "|") > 0 THEN MSG$ = "NO | IN THE DATE" : GOSUB 7000 : GOTO 2320
2360 IF JE >= 300 THEN MSG$ = "THE JOURNAL IS FULL" : GOSUB 7000 : RETURN
2370 LOCATE 21,5: PRINT SPACE$(70);
2380 LOCATE 21,5: PRINT USING "DR 1000 CASH   CR 1100 A/R   AMOUNT ####,###.##"; AM
2390 LOCATE 22,5: PRINT SPACE$(70); : PRINT "PRESS ENTER TO POST, OR N TO CANCEL: ";
2400 INPUT "", Z$
2410 IF Z$ = "N" OR Z$ = "n" THEN RETURN
2420 JE = JE + 1
2430 JY(JE) = 3 : JR$(JE) = RF$ : JT$(JE) = DT$ : JX$(JE) = "PAYMENT " + JX$(BI) : JD(JE) = 1000 : JC(JE) = 1100 : JM(JE) = AM
2440 GOSUB 5300
2450 RETURN
2600 REM ---- TRIAL BALANCE ---------------------------------------------
2610 GOSUB 6000
2620 CLS
2630 PRINT "TRIAL BALANCE"
2640 PRINT "AS OF "; DATE$
2650 PRINT
2660 PRINT "  ACCOUNT"; TAB(47); "DEBIT"; TAB(59); "CREDIT"
2670 PRINT "  " + STRING$(36, "-") + "  " + STRING$(11, "-") + "  " + STRING$(11, "-")
2680 TD = 0 : TC = 0
2690 FOR I = 1 TO NA
2700 D = 0 : C = 0
2710 IF BL(I) > 0 THEN D = BL(I)
2720 IF BL(I) < 0 THEN C = -BL(I)
2730 TD = TD + D : TC = TC + C
2740 PRINT USING FB$; NM$(I); D; C
2750 NEXT I
2760 PRINT "  " + STRING$(36, "-") + "  " + STRING$(11, "-") + "  " + STRING$(11, "-")
2770 PRINT USING FB$; "TOTAL"; TD; TC
2780 IF TD <> TC THEN 2800
2790 PRINT "DEBITS EQUAL CREDITS." : RETURN
2800 PRINT "OUT OF BALANCE - CHECK THE JOURNAL." : RETURN
2900 REM ---- INCOME STATEMENT ------------------------------------------
2910 GOSUB 6000
2920 CLS
2930 PRINT "INCOME STATEMENT"
2940 PRINT "PERIOD ENDING "; DATE$
2950 PRINT
2960 PRINT "REVENUE"
2970 RV = 0
2980 FOR I = 1 TO NA
2990 IF TY(I) <> 4 THEN 3030
3000 V = -BL(I) : RV = RV + V
3010 IF V <> 0 THEN PRINT USING FI$; NM$(I); V
3030 NEXT I
3040 PRINT USING FI$; "TOTAL REVENUE"; RV
3050 PRINT
3060 PRINT "EXPENSES"
3070 EX = 0
3080 FOR I = 1 TO NA
3090 IF TY(I) <> 5 THEN 3130
3100 V = BL(I) : EX = EX + V
3110 IF V <> 0 THEN PRINT USING FI$; NM$(I); V
3130 NEXT I
3140 PRINT USING FI$; "TOTAL EXPENSES"; EX
3150 PRINT
3160 IF RV - EX < 0 THEN 3190
3170 PRINT USING FI$; "NET INCOME"; RV - EX
3180 RETURN
3190 PRINT USING FI$; "NET LOSS"; RV - EX
3200 RETURN
3250 REM ---- BALANCE SHEET ---------------------------------------------
3260 GOSUB 6000
3270 CLS
3280 PRINT "BALANCE SHEET"
3290 PRINT "AS OF "; DATE$
3300 PRINT
3310 PRINT "ASSETS"
3320 TA = 0
3330 FOR I = 1 TO NA
3340 IF TY(I) <> 1 THEN 3380
3350 V = BL(I) : TA = TA + V
3360 IF V <> 0 THEN PRINT USING FI$; NM$(I); V
3380 NEXT I
3390 PRINT USING FI$; "TOTAL ASSETS"; TA
3400 PRINT
3410 PRINT "LIABILITIES"
3420 TL = 0
3430 FOR I = 1 TO NA
3440 IF TY(I) <> 2 THEN 3480
3450 V = -BL(I) : TL = TL + V
3460 IF V <> 0 THEN PRINT USING FI$; NM$(I); V
3480 NEXT I
3490 PRINT USING FI$; "TOTAL LIABILITIES"; TL
3500 PRINT
3510 PRINT "EQUITY"
3520 TE = 0
3530 FOR I = 1 TO NA
3540 IF TY(I) <> 3 THEN 3580
3550 V = -BL(I) : TE = TE + V
3560 IF V <> 0 THEN PRINT USING FI$; NM$(I); V
3580 NEXT I
3590 NI = 0
3600 FOR I = 1 TO NA
3610 IF TY(I) = 4 THEN NI = NI - BL(I)
3620 IF TY(I) = 5 THEN NI = NI - BL(I)
3630 NEXT I
3640 PRINT USING FI$; "CURRENT EARNINGS"; NI
3650 TE = TE + NI
3660 PRINT USING FI$; "TOTAL EQUITY"; TE
3670 PRINT
3680 PRINT USING FI$; "LIABILITIES + EQUITY"; TL + TE
3690 IF TA = TL + TE THEN 3720
3700 PRINT "CHECK: ASSETS DO NOT EQUAL LIABILITIES PLUS EQUITY."
3710 RETURN
3720 PRINT "BALANCED."
3730 RETURN
3750 REM ---- JOURNAL: J = JOURNAL, B = BILLING, P = PAYMENT -----------
3760 CLS
3770 PRINT "JOURNAL"
3780 PRINT "AS OF "; DATE$
3790 PRINT
3800 PRINT "  T"; TAB(6); "DATE"; TAB(18); "REF"; TAB(30); "DESCRIPTION"; TAB(54); "DR/CR"; TAB(65); "AMOUNT"
3810 PRINT "  " + "-" + "  " + STRING$(10, "-") + "  " + STRING$(10, "-") + "  " + STRING$(22, "-") + "  " + STRING$(4, "-") + "/" + STRING$(4, "-") + "  " + STRING$(11, "-")
3820 IF JE > 0 THEN 3850
3830 PRINT "  (NO ENTRIES YET)"
3840 RETURN
3850 FOR J = 1 TO JE
3860 T$ = "J"
3870 IF JY(J) = 2 THEN T$ = "B"
3880 IF JY(J) = 3 THEN T$ = "P"
3890 PRINT USING FJ$; T$; JT$(J); JR$(J); JX$(J); JD(J); JC(J); JM(J)
3900 NEXT J
3910 PRINT "  " + "-" + "  " + STRING$(10, "-") + "  " + STRING$(10, "-") + "  " + STRING$(22, "-") + "  " + STRING$(4, "-") + "/" + STRING$(4, "-") + "  " + STRING$(11, "-")
3920 TS = 0
3930 FOR J = 1 TO JE : TS = TS + JM(J) : NEXT J
3940 PRINT USING "  ENTRIES: ###   TOTAL POSTED: ####,###.##"; JE; TS
3950 RETURN
4000 REM ---- FIND AN ACCOUNT NUMBER: AN IN, AI OUT ----------------------
4010 AI = 0
4020 FOR I = 1 TO NA
4030 IF AC(I) = AN THEN AI = I : I = NA
4040 NEXT I
4050 RETURN
4100 REM ---- FIND A BILLING BY INVOICE NUMBER: RF$ IN, BI OUT -----------
4110 BI = 0
4120 FOR K = 1 TO JE
4130 IF JY(K) = 2 AND JR$(K) = RF$ THEN BI = K : K = JE
4140 NEXT K
4150 RETURN
4200 REM ---- TOTAL PAYMENTS AGAINST RF$: PD OUT -----------------------
4210 PD = 0
4220 FOR K = 1 TO JE
4230 IF JY(K) = 3 AND JR$(K) = RF$ THEN PD = PD + JM(K)
4240 NEXT K
4250 RETURN
4400 REM ---- SPLIT L$ ON "|" INTO F$(1..NF) ---------------------------
4410 NF = 0 : P = 1
4420 Q = INSTR(P, L$, "|")
4430 IF Q = 0 THEN NF = NF + 1 : F$(NF) = MID$(L$, P) : RETURN
4440 NF = NF + 1 : F$(NF) = MID$(L$, P, Q - P)
4450 P = Q + 1 : GOTO 4420
5000 REM ---- READ THE CHART OF ACCOUNTS FROM DATA ----------------------
5010 NA = 0
5020 READ AN, Q$, TT
5030 IF AN = 0 THEN 5060
5040 NA = NA + 1 : AC(NA) = AN : NM$(NA) = Q$ : TY(NA) = TT
5050 GOTO 5020
5060 RETURN
5100 REM ---- CREATE IF NEEDED AND LOAD THE JOURNAL FILE ---------------
5110 OPEN DF$ FOR APPEND AS #1
5120 CLOSE #1
5130 OPEN DF$ FOR INPUT AS #1
5140 JE = 0
5150 IF EOF(1) THEN 5250
5160 IF JE >= 300 THEN 5250
5170 LINE INPUT #1, L$
5180 GOSUB 4400
5190 IF NF <> 7 THEN 5230
5200 JE = JE + 1
5210 JY(JE) = VAL(F$(1)) : JR$(JE) = F$(2) : JT$(JE) = F$(3) : JX$(JE) = F$(4) : JD(JE) = VAL(F$(5)) : JC(JE) = VAL(F$(6)) : JM(JE) = VAL(F$(7))
5220 GOTO 5150
5230 CLS : PRINT "THE DATA FILE IS NOT IN THIS PROGRAM'S FORMAT."
5240 PRINT "RENAME OR DELETE samples\accounting.dat, THEN RUN AGAIN."
5245 END
5250 CLOSE #1
5260 RETURN
5300 REM ---- APPEND THE CURRENT ENTRY TO THE JOURNAL FILE -------------
5310 L$ = MID$(STR$(JY(JE)), 2) + "|" + JR$(JE) + "|" + JT$(JE) + "|" + JX$(JE) + "|" + MID$(STR$(JD(JE)), 2) + "|" + MID$(STR$(JC(JE)), 2) + "|" + MID$(STR$(JM(JE)), 2)
5320 OPEN DF$ FOR APPEND AS #1
5330 PRINT #1, L$
5340 CLOSE #1
5350 RETURN
6000 REM ---- BALANCES: DEBIT POSITIVE, CREDIT NEGATIVE -----------------
6010 FOR I = 1 TO NA : BL(I) = 0 : NEXT I
6020 FOR J = 1 TO JE
6030 FOR I = 1 TO NA
6040 IF AC(I) = JD(J) THEN BL(I) = BL(I) + JM(J)
6050 IF AC(I) = JC(J) THEN BL(I) = BL(I) - JM(J)
6060 NEXT I
6070 NEXT J
6080 RETURN
7000 REM ---- SHOW THE CURRENT MESSAGE ON THE ERROR LINE ---------------
7010 LOCATE 22,5: PRINT SPACE$(70);
7020 LOCATE 22,5: PRINT MSG$;
7030 RETURN
7200 REM ---- CLEAR THE ERROR LINE BEFORE THE NEXT FIELD ----------------
7210 LOCATE 22,5: PRINT SPACE$(70);
7220 RETURN
7600 REM ---- EDIT A PREFILLED FIELD AT R0,C0. DV$ IS THE RESULT ----------
7605 ED = 0
7610 LOCATE R0, C0: PRINT DV$; SPACE$(25); : LOCATE R0, C0 + LEN(DV$)
7620 K$ = INKEY$
7625 IF K$ <> "" THEN 7640
7630 FOR W = 1 TO 300 : NEXT W
7635 GOTO 7620
7640 IF K$ = CHR$(13) THEN 7740
7650 IF K$ = CHR$(8) THEN 7700
7660 IF LEN(K$) <> 1 THEN 7620
7670 C = ASC(K$)
7675 IF C < 32 OR C > 126 THEN 7620
7680 IF ED = 0 THEN DV$ = "" : ED = 1
7690 DV$ = DV$ + K$
7695 GOTO 7720
7700 IF LEN(DV$) > 0 THEN DV$ = LEFT$(DV$, LEN(DV$) - 1) : ED = 1
7720 LOCATE R0, C0: PRINT DV$; SPACE$(25); : LOCATE R0, C0 + LEN(DV$)
7730 GOTO 7620
7740 LOCATE R0, C0: PRINT DV$; SPACE$(25); : LOCATE R0, C0
7750 RETURN
7800 REM ---- VALIDATE DT$ AS MM/DD/YYYY. OK=1, OR VC=1 FORMAT, 2 RANGE --
7810 OK = 0 : VC = 1
7820 IF LEN(DT$) <> 10 THEN RETURN
7830 IF MID$(DT$, 3, 1) <> "/" OR MID$(DT$, 6, 1) <> "/" THEN RETURN
7840 FOR W = 1 TO 10
7850 IF W = 3 OR W = 6 THEN 7870
7860 C = ASC(MID$(DT$, W, 1)) : IF C < 48 OR C > 57 THEN RETURN
7870 NEXT W
7880 MM = VAL(MID$(DT$, 1, 2)) : DD = VAL(MID$(DT$, 4, 2)) : YY = VAL(MID$(DT$, 7, 4))
7890 IF MM < 1 OR MM > 12 THEN VC = 2 : RETURN
7900 IF YY < 1900 OR YY > 2099 THEN VC = 2 : RETURN
7910 MD = 31
7920 IF MM = 4 OR MM = 6 OR MM = 9 OR MM = 11 THEN MD = 30
7930 IF MM <> 2 THEN 7960
7940 MD = 28
7950 IF YY MOD 4 = 0 THEN MD = 29
7952 IF YY MOD 100 = 0 AND YY MOD 400 <> 0 THEN MD = 28
