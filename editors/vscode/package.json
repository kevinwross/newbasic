{
  "name": "newbasic-debug",
  "displayName": "newbasic debugger",
  "description": "Debug GW-BASIC programs with the newbasic interpreter.",
  "version": "0.1.0",
  "publisher": "newbasic",
  "engines": { "vscode": "^1.60.0" },
  "categories": ["Debuggers"],
  "main": "./extension.js",
  "activationEvents": ["onDebug", "onDebugResolve:newbasic"],
  "contributes": {
    "debuggers": [
      {
        "type": "newbasic",
        "label": "newbasic (GW-BASIC)",
        "configurationAttributes": {
          "launch": {
            "required": [],
            "properties": {
              "program": {
                "type": "string",
                "description": "Path to the .bas file to run.",
                "default": "${file}"
              },
              "programText": {
                "type": "string",
                "description": "Source to run instead of a file, for a scratch program."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "newbasic",
            "request": "launch",
            "name": "Run this program",
            "program": "${file}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "newbasic: run a program",
            "body": {
              "type": "newbasic",
              "request": "launch",
              "name": "Run this program",
              "program": "${file}"
            }
          }
        ]
      }
    ],
    "configuration": {
      "title": "newbasic",
      "properties": {
        "newbasic.adapterPath": {
          "type": "string",
          "default": "",
          "description": "Path to newbasic-dap.exe. Leave empty to use out/src/newbasic-dap/Release/newbasic-dap.exe in the workspace folder."
        },
        "newbasic.showWindow": {
          "type": "boolean",
          "default": true,
          "description": "Show the program's GUI window during debug sessions. Turn off to pass --nowindow and run with a headless screen."
        }
      }
    }
  }
}
