{
  "name": "newbasic-debug",
  "displayName": "newbasic debugger",
  "description": "Debug GW-BASIC programs with the newbasic interpreter on Windows, Linux and macOS.",
  "version": "0.1.0",
  "publisher": "newbasic",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Debuggers"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onDebug",
    "onDebugResolve:newbasic"
  ],
  "contributes": {
    "debuggers": [
      {
        "type": "newbasic",
        "label": "newbasic (GW-BASIC)",
        "configurationAttributes": {
          "launch": {
            "required": [],
            "properties": {
              "program": {
                "type": "string",
                "description": "Path to the .bas file to run.",
                "default": "${file}"
              },
              "programText": {
                "type": "string",
                "description": "Source to run instead of a file, for a scratch program."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "newbasic",
            "request": "launch",
            "name": "Run this program",
            "program": "${file}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "newbasic: run a program",
            "body": {
              "type": "newbasic",
              "request": "launch",
              "name": "Run this program",
              "program": "${file}"
            }
          }
        ],
        "languages": [
          "basic",
          "vb"
        ],
        "breakpoints": [
          {
            "language": "basic"
          },
          {
            "language": "vb"
          }
        ]
      }
    ],
    "configuration": {
      "title": "newbasic",
      "properties": {
        "newbasic.adapterPath": {
          "type": "string",
          "default": "",
          "description": "Path to the newbasic-dap executable (newbasic-dap.exe on Windows). Leave empty to search bin/Release, bin/Debug, build-sdl, build, then the Visual Studio out/ trees in the workspace folder."
        },
        "newbasic.showWindow": {
          "type": "boolean",
          "default": true,
          "description": "Show the program's GUI window during debug sessions. Turn off to pass --nowindow and run with a headless screen."
        },
        "newbasic.history": {
          "type": "boolean",
          "default": false,
          "description": "Record line-boundary VM snapshots for Step Back/reverse debugging. This costs a full VM copy per line, so it is off by default."
        }
      }
    }
  }
}
